# Optional. Without these, threat-intel lookups are skipped and findings are
# labeled "not_checked" - deobfuscation and IOC/signature extraction still
# work fully offline. You can also set/update these later from the
# Settings page in the web dashboard instead of editing this file.
#
# This is the single canonical list of provider keys - see
# plaguardsv2/GuardModules/PlagConfig.py for how they're resolved
# (Settings DB value wins, falls back to these env vars).

# https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# https://auth.abuse.ch/ (free account) - one key covers MalwareBazaar,
# ThreatFox, and URLhaus
ABUSECH_API_KEY=

# https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# https://otx.alienvault.com/api
OTX_API_KEY=

# https://account.shodan.io/
SHODAN_API_KEY=

# https://viz.greynoise.io/account/ (Community API key)
GREYNOISE_API_KEY=

# https://pulsedive.com/api/
PULSEDIVE_API_KEY=

# https://ipinfo.io/account/token - hosted IP geolocation, used only when no
# local GeoLite2 database below is configured.
IPINFO_TOKEN=

# Local MaxMind GeoLite2 databases - preferred over ipinfo: the address never
# leaves this machine. Fill in any mix of the three and they are merged into
# one record per address. Each accepts a .mmdb file, a folder, or MaxMind's
# .tar.gz exactly as downloaded. Free from
# https://dev.maxmind.com/geoip/geolite2-free-geolocation-data
GEOIP_CITY_DB_PATH=
GEOIP_COUNTRY_DB_PATH=
GEOIP_ASN_DB_PATH=

# Flask session secret - change this for anything beyond local use.
SECRET_KEY=change-me

# Where the SQLite DB lives (relative to the working directory / container).
PLAGUARDSV2_DB=data/plaguardsv2.db
